#!/usr/bin/env python3
"""
tmux pipe-pane output filter for tmux-logging.

Reads raw pane output on stdin and appends clean, timestamped lines to
the log file given as argv[1]. Filters:
  1. ANSI escape codes
  2. Shell prompt lines (bash, Kali zsh, PowerShell, Evil-WinRM, SQL)
  3. Empty / whitespace-only lines
  4. Command-line editing redraws (any screen line that contains a prompt)

Indentation is preserved. Output lines are never de-duplicated.

Usage (from tmux-log-start): tmux-log-filter <logfile> <window> <pane>
"""
import getpass
import io
import re
import socket
import sys
import time

if len(sys.argv) < 4:
    sys.exit(0)

logfile, win, pane = sys.argv[1], sys.argv[2], sys.argv[3]

try:
    out = open(logfile, "a", encoding="utf-8", errors="replace")
except OSError:
    sys.exit(0)

# Decode leniently so binary output (e.g. cat on a binary) can't crash the filter
# newline="" keeps \r and \n distinct; the default would turn every \r into \n
stdin = io.TextIOWrapper(sys.stdin.buffer, encoding="utf-8", errors="replace",
                         newline="")

# Looked up at runtime so the same file works for btheo, brad-theodore, b7h30
USER = re.escape(getpass.getuser())
HOST = re.escape(socket.gethostname())

ANSI_ESCAPE = re.compile(
    r'\x1b\[[0-?]*[ -/]*[@-~]'             # CSI (final byte is any of @-~, not just letters)
    r'|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)'  # OSC, ended by BEL or ST
    r'|\x1b[()][AB012]'                    # charset selection
    r'|\x1b.'                              # any other two-byte escape
    r'|[\x00-\x08\x0b-\x1f\x7f]'           # leftover control chars (tab is kept)
)

PROMPT_PATTERNS = [
    # This machine's user + host, with @ (bash, Kali backtrack) or ㉿ (Kali two-line)
    re.compile(rf'{USER}[@㉿]{HOST}'),
    # Kali two-line prompt frame: ┌──(...)-[~]  and  └─$
    re.compile(r'^\s*[┌└]─'),
    # Generic user@host:path$ prompt (e.g. on a box you've SSH'd into)
    re.compile(r'^\s*[\w.-]+@[\w.-]+:\S*[$#]'),
    # RHEL-style [user@host dir]$ prompt
    re.compile(r'^\s*\[[\w.-]+@[\w.-]+ [^\]]*\][$#]'),
    # Evil-WinRM
    re.compile(r'\*Evil-WinRM\*\s*PS\s+'),
    # PowerShell
    re.compile(r'^PS\s+[A-Za-z]:\\'),
    # SQL / mssqlclient
    re.compile(r'^SQL\s*\(.*\)>'),
    re.compile(r'^SQL>'),
    # Continuation and bare prompts
    re.compile(r'^>\s*$'),
    re.compile(r'^\s*[$#]\s*$'),
]

MAX_LINE = 65536  # force a flush if a program never sends a newline


def is_prompt(line):
    return any(p.search(line) for p in PROMPT_PATTERNS)


# Shells with bracketed paste (bash 5.1+, zsh, most readline programs) send
# ESC[?2004h when they start waiting for you to type and ESC[?2004l when you
# press Enter. Everything in between is command-line editing, not output.
PASTE_MODE = re.compile(r'(\x1b\[\?2004[hl])')
editing = False

buf = []


def drop_editing(raw):
    """Remove the parts of raw that were typed at a prompt."""
    global editing
    kept = []
    for part in PASTE_MODE.split(raw):
        if part == "\x1b[?2004h":
            editing = True
        elif part == "\x1b[?2004l":
            editing = False
        elif not editing:
            kept.append(part)
    return "".join(kept)


def flush():
    """Log one screen line (everything up to a newline).

    First, anything typed at a prompt is removed (see PASTE_MODE). For
    shells that don't send those markers, the prompt patterns below are
    the fallback.

    A carriage return (\\r) moves the cursor back to column 0 without
    starting a new line, so the pieces between \\r's are redraws of the
    SAME screen line. Two cases:
      - any piece is a shell prompt -> the whole line is you typing/editing
        a command (readline redraws); drop it. cmd.log has the command.
      - otherwise it is program output (e.g. a progress bar); keep only the
        last piece, which is what was left on screen.
    Real output lines are never dropped for repeating an earlier line.
    """
    global buf
    if not buf:
        return
    raw = drop_editing("".join(buf))
    buf = []
    pieces = [ANSI_ESCAPE.sub('', p).rstrip() for p in raw.split("\r")]
    pieces = [p for p in pieces if p.strip()]
    if not pieces or any(is_prompt(p) for p in pieces):
        return
    ts = time.strftime("[%Y-%m-%d %H:%M:%S]")
    out.write(f"{ts} [w={win}] [p={pane}] [OUT] {pieces[-1]}\n")
    out.flush()


try:
    while True:
        ch = stdin.read(1)
        if ch == "":
            break
        if ch == "\n":
            flush()
        else:
            buf.append(ch)
            if len(buf) >= MAX_LINE:
                flush()
finally:
    flush()
    out.close()
