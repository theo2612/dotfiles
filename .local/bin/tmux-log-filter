#!/usr/bin/env python3
"""
tmux pipe-pane output filter for tmux-logging.

Reads raw pane output on stdin and appends clean, timestamped lines to
the log file given as argv[1]. Filters:
  1. ANSI escape codes
  2. Shell prompt lines (bash, Kali zsh, PowerShell, Evil-WinRM, SQL)
  3. Empty / whitespace-only lines
  4. Rapid repeats within 0.5s (autocomplete redraw spam)

Usage (from tmux-log-start): tmux-log-filter <logfile> <window> <pane>
"""
import getpass
import io
import re
import socket
import sys
import time

if len(sys.argv) < 4:
    sys.exit(0)

logfile, win, pane = sys.argv[1], sys.argv[2], sys.argv[3]

try:
    out = open(logfile, "a", encoding="utf-8", errors="replace")
except OSError:
    sys.exit(0)

# Decode leniently so binary output (e.g. cat on a binary) can't crash the filter
stdin = io.TextIOWrapper(sys.stdin.buffer, encoding="utf-8", errors="replace")

# Looked up at runtime so the same file works for btheo, brad-theodore, b7h30
USER = re.escape(getpass.getuser())
HOST = re.escape(socket.gethostname())

ANSI_ESCAPE = re.compile(r'\x1b\[[0-9;?]*[a-zA-Z]|\x1b\][^\x07]*\x07|\x1b[()][AB012]|\x1b.')

PROMPT_PATTERNS = [
    # This machine's user + host, with @ (bash, Kali backtrack) or ㉿ (Kali two-line)
    re.compile(rf'{USER}[@㉿]{HOST}'),
    # Kali two-line prompt frame: ┌──(...)-[~]  and  └─$
    re.compile(r'^\s*[┌└]─'),
    # Generic user@host:path$ prompt (e.g. on a box you've SSH'd into)
    re.compile(r'^\s*[\w.-]+@[\w.-]+:\S*[$#]'),
    # Evil-WinRM
    re.compile(r'\*Evil-WinRM\*\s*PS\s+'),
    # PowerShell
    re.compile(r'^PS\s+[A-Za-z]:\\'),
    # SQL / mssqlclient
    re.compile(r'^SQL\s*\(.*\)>'),
    re.compile(r'^SQL>'),
    # Continuation and bare prompts
    re.compile(r'^>\s*$'),
    re.compile(r'^\s*[$#]\s*$'),
]

DEBOUNCE_WINDOW = 0.5
MAX_RECENT = 10
recent = []  # (line, timestamp)


def is_prompt(line):
    return any(p.search(line) for p in PROMPT_PATTERNS)


def is_recent_repeat(line, now):
    """True if line repeats (or is a prefix of) something seen in the last 0.5s."""
    global recent
    recent = [(l, t) for l, t in recent if now - t < DEBOUNCE_WINDOW]
    for prev, _ in recent:
        if line == prev or (prev.startswith(line) and len(line) < len(prev)):
            return True
    recent.append((line, now))
    if len(recent) > MAX_RECENT:
        recent.pop(0)
    return False


buf = []


def flush():
    global buf
    if not buf:
        return
    line = ANSI_ESCAPE.sub('', "".join(buf)).strip()
    buf = []
    if not line or is_prompt(line):
        return
    now = time.time()
    if is_recent_repeat(line, now):
        return
    ts = time.strftime("[%Y-%m-%d %H:%M:%S]")
    out.write(f"{ts} [w={win}] [p={pane}] [OUT] {line}\n")
    out.flush()


try:
    while True:
        ch = stdin.read(1)
        if ch == "":
            break
        if ch in ("\n", "\r"):
            flush()
        else:
            buf.append(ch)
finally:
    flush()
    out.close()
